{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "src/**",
      "public/**",
      "drizzle/**",
      "scripts/**",
      "packages/nb-cli/lib/**",
      "packages/nb-cli/schema/**",
      "packages/nb-cli/CHANGELOG.md",
      "package.json",
      "package-lock.json",
      "next.config.ts",
      "tsconfig.json",
      "Dockerfile",
      "railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/v1/live",
    "healthcheckTimeout": 100
  }
}
