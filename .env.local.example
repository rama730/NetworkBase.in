NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_web_oauth_client_id.apps.googleusercontent.com
# Enable only after migration 0157 and private topic authorization tests pass.
NEXT_PUBLIC_REALTIME_AUTHORIZATION_ENABLED=0
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=optional_for_symmetric_jwt_projects
NEXT_PUBLIC_TURNSTILE_SITE_KEY=optional_turnstile_site_key
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public legal identity (required before production publication)
LEGAL_OPERATOR_NAME=your_registered_legal_name
LEGAL_OPERATOR_ADDRESS=your_full_service_postal_address
LEGAL_OPERATOR_COUNTRY=India
LEGAL_SUPPORT_EMAIL=support@networkbase.in
LEGAL_PRIVACY_EMAIL=privacy@networkbase.in
LEGAL_WELCOME_EMAIL=welcome@networkbase.in
LEGAL_NOTIFICATIONS_EMAIL=notifications@networkbase.in
LEGAL_GRIEVANCE_OFFICER_NAME=your_named_grievance_officer
LEGAL_GRIEVANCE_EMAIL=grievance@networkbase.in
LEGAL_GOVERNING_LAW=the laws of your governing state and India
LEGAL_DISPUTE_VENUE=the competent courts in your selected city and state, India
# Use a least-privilege application role with neither SUPERUSER nor BYPASSRLS.
DATABASE_URL=your_runtime_database_connection_string
# Disposable databases only. Never point these at DATABASE_URL.
DATABASE_URL_FRESH=your_fresh_migration_replay_database
DATABASE_URL_REPLAY_FRESH=optional_second_fresh_replay_database
# One-time legacy adoption only; keep disabled for normal operation.
ALLOW_MIGRATION_JOURNAL_BOOTSTRAP=0
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_EXECUTION_ROLE=worker
# Transactional application emails (separate from Supabase authentication SMTP).
# Keep disabled until migration 0205 and the signed Resend webhook are ready.
RESEND_EMAIL_ENABLED=false
# Worker only. Never use NEXT_PUBLIC_ or commit real credentials.
RESEND_API_KEY=
# Web only; copied from the Resend webhook endpoint signing secret.
RESEND_WEBHOOK_SECRET=
# Required outside Railway's production environment, even for production builds.
RESEND_TEST_RECIPIENTS=
GITHUB_IMPORT_TOKEN_ENCRYPTION_KEY=generate_a_long_random_secret
GITHUB_IMPORT_MAX_FILES=6000
GITHUB_IMPORT_MAX_TOTAL_BYTES=1073741824
GITHUB_IMPORT_MAX_DIRS=8000
PROJECT_UPLOAD_MAX_FILE_BYTES=10485760
SUPABASE_STORAGE_IMAGE_TRANSFORMATIONS_ENABLED=false
ATTACHMENT_UPLOAD_MAX_FILE_BYTES=52428800
PROFILE_IMAGE_UPLOAD_MAX_FILE_BYTES=2097152

# Independent object backup account. The application role should have write,
# head, and restore access but no permission to delete protected versions.
STORAGE_BACKUP_AWS_ACCESS_KEY_ID=your_backup_writer_access_key
STORAGE_BACKUP_AWS_SECRET_ACCESS_KEY=your_backup_writer_secret
STORAGE_BACKUP_AWS_SESSION_TOKEN=optional_for_temporary_credentials
STORAGE_BACKUP_AWS_REGION=ap-south-1
STORAGE_BACKUP_AWS_BUCKET=your_private_backup_bucket
STORAGE_BACKUP_AWS_ENDPOINT=optional_s3_compatible_endpoint

# Optional auth middleware tuning (milliseconds)
AUTH_MIDDLEWARE_LOOKUP_TIMEOUT_MS=4000
AUTH_DEGRADED_MODE_ENABLED=1
AUTH_HARDENING_PHASE=9
GITHUB_SYNC_MAX_FILES=15000
GITHUB_SYNC_MAX_BYTES=536870912
GITHUB_SYNC_MAX_FILE_BYTES=10485760
GITHUB_SYNC_APPLY_CONCURRENCY=8
APP_ROUTE_P95_LOAD_BUDGET_MS=1500
APP_ROUTE_P95_TTFB_BUDGET_MS=300
ROUTE_BASELINE_REGRESSION_CHECK=1
ROUTE_BASELINE_LOAD_MAX_REGRESSION_RATIO=0.35
ROUTE_BASELINE_TTFB_MAX_REGRESSION_RATIO=0.5

# E2E
# E2E and DB checks never touch the primary project: point these at a
# disposable Supabase branch (database + Auth/storage of the same branch).
E2E_DATABASE_URL=your_disposable_e2e_database
E2E_SUPABASE_URL=your_disposable_supabase_url
E2E_SUPABASE_ANON_KEY=your_disposable_anon_key
E2E_SUPABASE_SERVICE_ROLE_KEY=your_disposable_service_role_key
E2E_USER_EMAIL=your_e2e_user_email
E2E_USER_PASSWORD=your_e2e_user_password
E2E_ONBOARDING_PASSWORD=your_e2e_onboarding_password
E2E_BASE_URL=http://localhost:3000
E2E_RUN_ID=optional_run_id
E2E_SCOPE=critical
E2E_BROWSER_MATRIX=gate
E2E_PERF_GATE=1
E2E_DEV_SERVER_MODE=webpack
E2E_AUTH_FALLBACK=0
PLAYWRIGHT_TEST=0

# Client IP trust (production). Set one: a header the edge proxy overwrites, or the number of proxies that append to x-forwarded-for.
# TRUSTED_PROXY_IP_HEADER=cf-connecting-ip
TRUSTED_PROXY_HOPS=1
