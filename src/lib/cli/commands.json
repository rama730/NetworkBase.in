    {
      "name": "push",
      "summary": "Upload changes; same path = new version",
      "usage": "nb push <path...> [--task 4 --as draft] [-m text]",
      "flags": {
        "task": {
          "type": "string",
          "short": "t",
          "describe": "Task number or id (default: the started task)",
          "valueName": "task"
        },
        "as": {
          "type": "string",
          "describe": "File role: reference, draft or final",
          "valueName": "role"
        },
        "message": {
          "type": "string",
          "short": "m",
          "describe": "Text for this command",
          "valueName": "text"
        },
        "dry-run": {
          "type": "boolean",
          "describe": "Show what would happen, change nothing"
        },
        "all": {
          "type": "boolean",
          "describe": "Push every changed tracked file (needed when not interactive and no paths)"
        },
        "folder": {
          "type": "string",
          "describe": "Workspace folder to put the files in",
          "valueName": "/folder"
        },
        "keep-both": {
          "type": "boolean",
          "describe": "A changed file whose name is taken goes in as name (2).ext"
        },
        "force": {
          "type": "boolean",
          "describe": "Replace a newer server version after a conflict (asks first)"
        },
        "recreate": {
          "type": "boolean",
          "describe": "Upload again files that were deleted on the server but you still have"
        },
        "no-task": {
          "type": "boolean",
          "describe": "Don't link these files to the task you started"
        },
        "from-git": {
          "type": "boolean",
          "describe": "Push what the last git commit changed (its NetworkBase-Task trailer picks the task)"
        },
        "confirm-secrets": {
          "type": "boolean",
          "describe": "Upload even though a file looks like it holds a password or key"
        }
      },
      "examples": [
        "nb push src/app.ts -m \"Fix login\"",
        "nb push report.pdf --task 4 --as final",
        "nb push shots/ --task 5 --as reference"
      ],
      "exitCodes": [
        0,
        2,
        4,
        5,
        7,
        8
      ]
    },
