          "valueName": "person"
        },
        "sprint": {
          "type": "string",
          "describe": "A sprint name, current, or id",
          "valueName": "sprint"
        },
        "priority": {
          "type": "string",
          "describe": "low,medium,high,urgent",
          "valueName": "list"
        },
        "sort": {
          "type": "string",
          "describe": "due, priority or updated (default)",
          "valueName": "by"
        },
        "save": {
          "type": "string",
          "describe": "Save these filters under a name (nb task list @name)",
          "valueName": "name"
        }
