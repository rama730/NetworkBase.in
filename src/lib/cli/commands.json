{
  "commands": [
    {
      "name": "login",
      "summary": "Sign in (browser, a code, or a token from stdin)",
      "usage": "nb login [--device] [--agent name [--access full|small|read] [--workspace ws|--all-workspaces]] [--with-token]",
      "flags": {
        "with-token": {
          "type": "boolean",
          "describe": "Read a token from stdin (CI, scripts)"
        },
        "device": {
          "type": "boolean",
          "describe": "Sign in with a code you approve on another device (automatic over SSH)"
        },
        "agent": {
          "type": "string",
          "describe": "Sign in an AI agent; you approve where it works and what it may do",
          "valueName": "name"
        },
        "access": {
          "type": "string",
          "describe": "What the agent asks for: full, small or read (the page starts there)",
          "valueName": "level"
        },
        "all-workspaces": {
          "type": "boolean",
          "describe": "The agent asks for all your workspaces"
        }
      },
      "examples": [
        "nb login",
        "nb login --device",
        "nb login --device --agent \"Claude Code\"",
        "nb login --device --agent \"Claude Code\" --access read --all-workspaces",
        "echo $NB_TOKEN | nb login --with-token"
      ],
      "exitCodes": [
        0,
        3,
        130
      ]
    },
