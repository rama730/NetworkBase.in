    {
      "name": "task list",
      "summary": "Tasks (default: yours, not done)",
      "usage": "nb task list [@saved] [--mine|--all] [--status list] [--due week] [--to @sam] [--sprint current] [--priority high] [--sort due] [--save name]",
      "flags": {
        "mine": {
