{
  "name": "nb-s3",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "dev:web": "next dev --turbo",
    "dev:lan": "next dev -H 0.0.0.0 --turbo",
    "build": "next build --webpack",
    "analyze:bundle": "ANALYZE=true next build --webpack",
    "start": "NODE_OPTIONS='--max-old-space-size=700' next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test 'tests/unit/**/*.test.ts'",
    "test:db": "tsx --test --test-concurrency=1 'tests/db/**/*.test.ts'",
    "test:unit:coverage": "node --import tsx --test --test-reporter=spec --experimental-test-coverage --test-coverage-lines=70 --test-coverage-functions=60 --test-coverage-branches=60 'tests/unit/**/*.test.ts'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:setup": "tsx scripts/setup-database.ts",
    "db:baseline": "tsx scripts/db/dump-baseline.ts",
    "db:disposable": "bash scripts/db/disposable-db.sh",
    "seed:e2e:fixtures": "tsx scripts/seed-e2e-fixtures.ts",
    "cleanup:e2e:fixtures": "tsx scripts/cleanup-e2e-fixtures.ts",
    "check:files:store-boundary": "tsx scripts/check-files-store-imports.ts",
    "check:db:migration-journal": "tsx scripts/check-migration-journal.ts",
    "check:db:migration-sources": "tsx scripts/setup-database.ts --dry-run",
    "check:db:live-lineage": "tsx scripts/check-live-migration-lineage.ts",
    "check:db:runtime-role": "tsx scripts/check-runtime-database-role.ts",
    "check:db-catalog-drift": "tsx scripts/check-db-catalog-drift.ts",
    "check:chat:db": "tsx scripts/check-chat-database.ts",
    "check:chat:actions": "tsx scripts/check-chat-actions.ts",
    "check:discover": "tsx scripts/check-discover-feed.ts",
    "check:application-data": "tsx scripts/check-application-data.ts",
    "skills:generate": "tsx scripts/generate-skill-catalog.ts",
    "skills:backfill": "node --env-file=.env.local --import tsx scripts/db/repair/backfill-market-skills.ts",
    "check:skills:catalog": "tsx scripts/check-skill-catalog.ts",
    "check:skills:visibility": "tsx scripts/check-skill-icon-visibility.ts",
    "check:skills:assignments": "node --env-file=.env.local --import tsx scripts/check-skill-assignment-parity.ts",
    "check:project-updates-schema": "tsx scripts/check-project-updates-schema.ts",
    "check:db:remigration-replay": "tsx scripts/check-db-remigration-replay.ts",
    "repair:file-versions": "node --env-file=.env.local --import tsx scripts/db/repair/repair-missing-file-versions.ts",
    "repair:file-hashes": "node --env-file=.env.local --import tsx scripts/db/repair/backfill-file-hashes.ts",
    "repair:current-file-drift": "node --env-file=.env.local --import tsx scripts/db/repair/repair-current-file-reference-drift.ts",
    "repair:legacy-storage-assets": "node --env-file=.env.local --import tsx scripts/db/repair/migrate-legacy-storage-assets.ts",
    "repair:legacy-profile-images": "node --env-file=.env.local --import tsx scripts/db/repair/migrate-legacy-profile-images.ts",
    "audit:storage-migration": "node --env-file=.env.local --import tsx scripts/db/inspect/audit-storage-migration.ts",
    "repair:storage-quotas": "node --env-file=.env.local --import tsx scripts/db/repair/reconcile-storage-quotas.ts",
    "check:onboarding:slo": "tsx scripts/check-onboarding-slo.ts",
    "check:scroll-contract": "tsx scripts/check-scroll-contract.ts",
    "check:head-contract": "tsx scripts/check-head-contract.ts",
    "check:query-key-contract": "tsx scripts/check-query-key-contract.ts",
    "check:global-search-contract": "tsx scripts/check-global-search-contract.ts",
    "check:profile-contributions": "tsx scripts/check-profile-contribution-contract.ts",
    "check:profile-contributions:db": "tsx scripts/check-profile-contribution-database.ts",
    "check:theme-contract": "tsx scripts/check-theme-contract.ts",
    "check:brand-contract": "tsx scripts/check-brand-system-contract.ts",
    "check:appearance-contract": "tsx scripts/check-appearance-contract.ts",
    "check:page-contract": "tsx scripts/check-page-performance-contract.ts",
    "check:build-rendering-contract": "tsx scripts/check-build-rendering-contract.ts",
    "check:force-dynamic-allowlist": "tsx scripts/check-force-dynamic-allowlist.ts",
    "check:runtime-boundaries": "tsx scripts/check-runtime-boundaries.ts",
    "check:api-versioning-contract": "tsx scripts/check-api-versioning-contract.ts",
    "check:api-envelope-contract": "tsx scripts/check-api-envelope-contract.ts",
    "freeze:route-baseline": "tsx scripts/freeze-route-baseline.ts",
    "check:route-baseline-regression": "tsx scripts/check-route-baseline-regression.ts",
    "check:deps:audit": "npm audit --omit=dev --audit-level=moderate",
    "check:deps:lockfile": "bash scripts/check-lockfile-drift.sh",
    "check:review-guardrails": "bash scripts/check-review-guardrails.sh",
    "check:security-env-contract": "tsx scripts/check-security-env-contract.ts --target=production",
    "check:legal-readiness": "node --env-file=.env.local --import tsx scripts/check-legal-readiness.ts",
    "deploy:legal:verify": "node --env-file=.env.local scripts/deploy-legal-acceptance.mjs --verify",
    "deploy:legal:apply": "node --env-file=.env.local scripts/deploy-legal-acceptance.mjs --apply",
    "check:rls-contract": "tsx scripts/check-rls-contract.ts",
    "check:authz-contract": "tsx scripts/check-authz-contract.ts",
    "check:csp-contract": "tsx scripts/check-csp-contract.ts",
    "check:trusted-proxy-contract": "tsx scripts/check-trusted-proxy-contract.ts",
    "check:webhook-identity-contract": "tsx scripts/check-webhook-identity-contract.ts",
    "check:realtime-origin-contract": "tsx scripts/check-realtime-origin-contract.ts",
    "check:e2e-auth-bundle-contract": "tsx scripts/check-e2e-auth-bundle-contract.ts",
    "check:security-evidence": "tsx scripts/generate-security-remediation-evidence.ts",
    "check:canonical-logic-contract": "tsx scripts/check-canonical-logic-contract.ts",
    "check:data-shape-contract": "tsx scripts/check-data-shape-contract.ts",
    "check:sql-governance": "tsx scripts/check-sql-governance.ts",
    "check:impact-review": "tsx scripts/check-impact-review.ts",
    "check:engineering-standards": "npm run check:canonical-logic-contract && npm run check:data-shape-contract && npm run check:sql-governance && npm run check:skills:catalog && npm run check:skills:visibility && npm run check:impact-review",
    "test:e2e:critical": "npm run test:e2e:critical:prod",
    "test:e2e:critical:dev": "E2E_SCOPE=critical E2E_BROWSER_MATRIX=gate tsx scripts/run-e2e-with-server.ts",
    "test:e2e:critical:prod": "npm run build && E2E_SCOPE=critical E2E_BROWSER_MATRIX=gate tsx scripts/run-e2e-with-prod-server.ts",
    "test:e2e:full": "E2E_SCOPE=full E2E_BROWSER_MATRIX=gate tsx scripts/run-e2e-with-server.ts",
    "test:e2e:nightly": "E2E_SCOPE=full E2E_BROWSER_MATRIX=nightly playwright test",
    "check:e2e:perf": "tsx scripts/check-e2e-perf-gate.ts",
    "test:release-gate": "npm run lint -- --no-error-on-unmatched-pattern \"src/**/*.ts\" \"src/**/*.tsx\" \"src/**/*.js\" \"src/**/*.jsx\" \"tests/**/*.ts\" \"tests/**/*.tsx\" \"tests/**/*.js\" \"tests/**/*.jsx\" \"scripts/**/*.ts\" \"scripts/**/*.tsx\" \"scripts/**/*.js\" \"scripts/**/*.jsx\" \"scripts/**/*.cjs\" \"scripts/**/*.mjs\" \"*.js\" \"*.mjs\" \"*.cjs\" \"*.ts\" && npm run typecheck && npm run check:deps:audit && npm run check:deps:lockfile && npm run check:db:migration-journal && npm run check:db:migration-sources && npm run check:db:remigration-replay && npm run check:db:live-lineage && npm run check:db:runtime-role && npm run check:security-env-contract && npm run check:rls-contract && npm run check:authz-contract && npm run check:csp-contract && npm run check:trusted-proxy-contract && npm run check:webhook-identity-contract && npm run check:realtime-origin-contract && npm run check:e2e-auth-bundle-contract && npm run check:security-evidence && npm run test:unit:coverage && npm run check:scroll-contract && npm run check:query-key-contract && npm run check:theme-contract && npm run check:page-contract && npm run check:force-dynamic-allowlist && npm run check:runtime-boundaries && npm run check:api-versioning-contract && npm run check:api-envelope-contract && npm run check:review-guardrails && npm run check:engineering-standards && npm run test:e2e:critical:prod && npm run check:build-rendering-contract && npm run check:e2e:perf && npm run check:route-baseline-regression"
  },
